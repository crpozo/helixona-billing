[Unit]
Description=Helixona Billing Agent (Denials Bot)
After=network.target xvfb@103.service
# Wants (not Requires): a flapping display must not crash-loop the worker. See
# helixona-agent.service for the rationale.
Wants=xvfb@103.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/helixona-agent
ExecStart=/opt/helixona-agent/venv/bin/python -m src.main
Restart=always
RestartSec=10
Environment=DISPLAY=:103
Environment=BOT_ROLE=denials

[Install]
WantedBy=multi-user.target
