[Unit]
Description=Helixona — queue the unlocked-notes notices (3 business days) for the Intake bot
After=network.target helixona-dashboard.service

[Service]
Type=oneshot
# The dashboard's own task endpoint, so the message carries the same shape a
# click on the Run card does. weekly is false: notices only.
ExecStart=/usr/bin/curl -sS -X POST http://127.0.0.1:5050/api/send-task -H 'Content-Type: application/json' \
    -d '{"bot": "submissions", "task_type": "unlocked_notes", "weekly": false, "remind": false, "dry_run": false}'
